<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>social_nav_costs</name>
  <version>0.1.0</version>
  <description>
    Nav2 costmap plugins for the SocialNav Planner: SocialLayer injects anisotropic human
    personal-space cost so the planner routes around people, and RestrictedZoneLayer stamps
    configured keep-out rectangles so it routes around restricted areas and heavy machinery.
  </description>
  <maintainer email="sandeepnaik89711@gmail.com">Sandeep</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>geometry_msgs</depend>
  <depend>social_nav_msgs</depend>
  <depend>social_nav_core</depend>
  <depend>eigen</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/social_layer_plugin.xml" />
  </export>
</package>
