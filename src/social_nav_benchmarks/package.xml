<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>social_nav_benchmarks</name>
  <version>0.1.0</version>
  <description>
    Automated benchmarking framework for the SocialNav Planner: runs deterministic
    scenarios headless, records metrics, writes JSON/CSV/report.
  </description>
  <maintainer email="sandeepnaik89711@gmail.com">Sandeep</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>social_nav_msgs</exec_depend>
  <exec_depend>social_nav_bringup</exec_depend>
  <exec_depend>social_nav_tools</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <!-- Baseline controllers compared against social_nav (selected by the planner flag). -->
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>dwb_core</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
