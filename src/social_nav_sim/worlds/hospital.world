<?xml version="1.0"?>
<!-- SocialNav hospital / service scene (Gazebo Classic SDF). A main corridor (y in
     [-1.6, 1.6]) running east, with rooms behind the corridor walls, doorway gaps that let
     people emerge, a nurse-station desk that pinches the corridor, a reception desk near the
     entrance and a waiting bench. Walls/desks exceed the ~0.4 m lidar. Robot at the origin;
     primitives only, no meshes, no online model DB. -->
<sdf version="1.6">
  <world name="hospital_world">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <light name="fill" type="directional"><pose>4 0 9 0 0 0</pose>
      <diffuse>0.6 0.6 0.62 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 0.1 -1.0</direction><cast_shadows>false</cast_shadows></light>
    <physics type="ode"><max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor><real_time_update_rate>200</real_time_update_rate></physics>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros><update_rate>20.0</update_rate></plugin>

    <!-- Corridor north wall (door gaps at x 2.5-3.5 and 6.0-7.0) -->
    <model name="wall_n1"><static>true</static><link name="l">
      <collision name="c"><pose>0.75 1.6 1.1 0 0 0</pose><geometry><box><size>3.5 0.15 2.2</size></box></geometry></collision>
      <visual name="v"><pose>0.75 1.6 1.1 0 0 0</pose><geometry><box><size>3.5 0.15 2.2</size></box></geometry>
        <material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual></link></model>
    <model name="wall_n2"><static>true</static><link name="l">
      <collision name="c"><pose>4.75 1.6 1.1 0 0 0</pose><geometry><box><size>2.5 0.15 2.2</size></box></geometry></collision>
      <visual name="v"><pose>4.75 1.6 1.1 0 0 0</pose><geometry><box><size>2.5 0.15 2.2</size></box></geometry>
        <material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual></link></model>
    <model name="wall_n3"><static>true</static><link name="l">
      <collision name="c"><pose>8.75 1.6 1.1 0 0 0</pose><geometry><box><size>3.5 0.15 2.2</size></box></geometry></collision>
      <visual name="v"><pose>8.75 1.6 1.1 0 0 0</pose><geometry><box><size>3.5 0.15 2.2</size></box></geometry>
        <material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual></link></model>
    <!-- Corridor south wall (door gap at x 4.0-5.0) -->
    <model name="wall_s1"><static>true</static><link name="l">
      <collision name="c"><pose>1.5 -1.6 1.1 0 0 0</pose><geometry><box><size>5.0 0.15 2.2</size></box></geometry></collision>
      <visual name="v"><pose>1.5 -1.6 1.1 0 0 0</pose><geometry><box><size>5.0 0.15 2.2</size></box></geometry>
        <material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual></link></model>
    <model name="wall_s2"><static>true</static><link name="l">
      <collision name="c"><pose>7.5 -1.6 1.1 0 0 0</pose><geometry><box><size>5.0 0.15 2.2</size></box></geometry></collision>
      <visual name="v"><pose>7.5 -1.6 1.1 0 0 0</pose><geometry><box><size>5.0 0.15 2.2</size></box></geometry>
        <material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual></link></model>

    <!-- Room back walls + ends (enclose the rooms behind the corridor) -->
    <model name="back_n"><static>true</static><link name="l">
      <visual name="v"><pose>4.75 4.0 1.1 0 0 0</pose><geometry><box><size>11.5 0.15 2.2</size></box></geometry>
        <material><ambient>0.78 0.80 0.82 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse></material></visual>
      <collision name="c"><pose>4.75 4.0 1.1 0 0 0</pose><geometry><box><size>11.5 0.15 2.2</size></box></geometry></collision></link></model>
    <model name="back_s"><static>true</static><link name="l">
      <visual name="v"><pose>4.75 -4.0 1.1 0 0 0</pose><geometry><box><size>11.5 0.15 2.2</size></box></geometry>
        <material><ambient>0.78 0.80 0.82 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse></material></visual>
      <collision name="c"><pose>4.75 -4.0 1.1 0 0 0</pose><geometry><box><size>11.5 0.15 2.2</size></box></geometry></collision></link></model>
    <model name="end_e"><static>true</static><link name="l">
      <collision name="c"><pose>10.5 0 1.1 0 0 0</pose><geometry><box><size>0.15 8.0 2.2</size></box></geometry></collision>
      <visual name="v"><pose>10.5 0 1.1 0 0 0</pose><geometry><box><size>0.15 8.0 2.2</size></box></geometry>
        <material><ambient>0.78 0.80 0.82 1</ambient><diffuse>0.78 0.80 0.82 1</diffuse></material></visual></link></model>

    <!-- Nurse-station desk (pinches the corridor), reception desk, waiting bench -->
    <model name="nurse_desk"><static>true</static><link name="l">
      <collision name="c"><pose>5.0 1.25 0.45 0 0 0</pose><geometry><box><size>1.5 0.6 0.9</size></box></geometry></collision>
      <visual name="v"><pose>5.0 1.25 0.45 0 0 0</pose><geometry><box><size>1.5 0.6 0.9</size></box></geometry>
        <material><ambient>0.30 0.45 0.55 1</ambient><diffuse>0.30 0.45 0.55 1</diffuse></material></visual></link></model>
    <model name="reception"><static>true</static><link name="l">
      <collision name="c"><pose>1.5 -1.25 0.5 0 0 0</pose><geometry><box><size>1.2 0.6 1.0</size></box></geometry></collision>
      <visual name="v"><pose>1.5 -1.25 0.5 0 0 0</pose><geometry><box><size>1.2 0.6 1.0</size></box></geometry>
        <material><ambient>0.35 0.40 0.48 1</ambient><diffuse>0.35 0.40 0.48 1</diffuse></material></visual></link></model>
    <model name="bench"><static>true</static><link name="l">
      <collision name="c"><pose>7.5 -1.3 0.25 0 0 0</pose><geometry><box><size>1.0 0.4 0.5</size></box></geometry></collision>
      <visual name="v"><pose>7.5 -1.3 0.25 0 0 0</pose><geometry><box><size>1.0 0.4 0.5</size></box></geometry>
        <material><ambient>0.45 0.42 0.35 1</ambient><diffuse>0.45 0.42 0.35 1</diffuse></material></visual></link></model>
  </world>
</sdf>
