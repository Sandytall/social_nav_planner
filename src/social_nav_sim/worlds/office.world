<?xml version="1.0"?>
<!-- SocialNav office / commercial scene (Gazebo Classic SDF). A main corridor (y in
     [-1.6, 1.6]) running east: walled meeting rooms with doorways to the north, an open-plan
     desk workspace to the south, a reception desk near the entrance. Desks/walls exceed the
     ~0.4 m lidar. Robot at the origin; primitives only, no meshes, no online model DB. -->
<sdf version="1.6">
  <world name="office_world">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <light name="fill" type="directional"><pose>4 0 9 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 -0.1 -1.0</direction><cast_shadows>false</cast_shadows></light>
    <physics type="ode"><max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor><real_time_update_rate>200</real_time_update_rate></physics>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros><update_rate>20.0</update_rate></plugin>

    <!-- Meeting-room wall to the north (door gaps at x 2.5-3.5 and 6.5-7.5) -->
    <model name="mr_w1"><static>true</static><link name="l">
      <collision name="c"><pose>0.75 1.6 1.1 0 0 0</pose><geometry><box><size>3.5 0.15 2.2</size></box></geometry></collision>
      <visual name="v"><pose>0.75 1.6 1.1 0 0 0</pose><geometry><box><size>3.5 0.15 2.2</size></box></geometry>
        <material><ambient>0.80 0.82 0.86 1</ambient><diffuse>0.80 0.82 0.86 1</diffuse></material></visual></link></model>
    <model name="mr_w2"><static>true</static><link name="l">
      <collision name="c"><pose>5.0 1.6 1.1 0 0 0</pose><geometry><box><size>3.0 0.15 2.2</size></box></geometry></collision>
      <visual name="v"><pose>5.0 1.6 1.1 0 0 0</pose><geometry><box><size>3.0 0.15 2.2</size></box></geometry>
        <material><ambient>0.80 0.82 0.86 1</ambient><diffuse>0.80 0.82 0.86 1</diffuse></material></visual></link></model>
    <model name="mr_w3"><static>true</static><link name="l">
      <collision name="c"><pose>9.0 1.6 1.1 0 0 0</pose><geometry><box><size>3.0 0.15 2.2</size></box></geometry></collision>
      <visual name="v"><pose>9.0 1.6 1.1 0 0 0</pose><geometry><box><size>3.0 0.15 2.2</size></box></geometry>
        <material><ambient>0.80 0.82 0.86 1</ambient><diffuse>0.80 0.82 0.86 1</diffuse></material></visual></link></model>
    <model name="mr_back"><static>true</static><link name="l">
      <collision name="c"><pose>5.0 3.8 1.1 0 0 0</pose><geometry><box><size>12.0 0.15 2.2</size></box></geometry></collision>
      <visual name="v"><pose>5.0 3.8 1.1 0 0 0</pose><geometry><box><size>12.0 0.15 2.2</size></box></geometry>
        <material><ambient>0.76 0.78 0.82 1</ambient><diffuse>0.76 0.78 0.82 1</diffuse></material></visual></link></model>
    <model name="glass_partition"><static>true</static><link name="l">
      <collision name="c"><pose>4.0 2.6 0.9 0 0 0</pose><geometry><box><size>0.1 2.2 1.8</size></box></geometry></collision>
      <visual name="v"><pose>4.0 2.6 0.9 0 0 0</pose><geometry><box><size>0.1 2.2 1.8</size></box></geometry>
        <material><ambient>0.4 0.55 0.6 0.5</ambient><diffuse>0.4 0.55 0.6 0.5</diffuse></material></visual></link></model>

    <!-- Reception desk near the entrance (edge of the corridor) -->
    <model name="reception"><static>true</static><link name="l">
      <collision name="c"><pose>1.6 -1.2 0.5 0 0 0</pose><geometry><box><size>1.6 0.6 1.0</size></box></geometry></collision>
      <visual name="v"><pose>1.6 -1.2 0.5 0 0 0</pose><geometry><box><size>1.6 0.6 1.0</size></box></geometry>
        <material><ambient>0.30 0.38 0.5 1</ambient><diffuse>0.30 0.38 0.5 1</diffuse></material></visual></link></model>

    <!-- Open-plan desk clusters to the south (workspace) -->
    <model name="desks_1"><static>true</static><link name="l">
      <collision name="c"><pose>3.5 -2.8 0.38 0 0 0</pose><geometry><box><size>2.0 1.6 0.76</size></box></geometry></collision>
      <visual name="v"><pose>3.5 -2.8 0.38 0 0 0</pose><geometry><box><size>2.0 1.6 0.76</size></box></geometry>
        <material><ambient>0.42 0.40 0.36 1</ambient><diffuse>0.42 0.40 0.36 1</diffuse></material></visual></link></model>
    <model name="desks_2"><static>true</static><link name="l">
      <collision name="c"><pose>7.0 -2.8 0.38 0 0 0</pose><geometry><box><size>2.0 1.6 0.76</size></box></geometry></collision>
      <visual name="v"><pose>7.0 -2.8 0.38 0 0 0</pose><geometry><box><size>2.0 1.6 0.76</size></box></geometry>
        <material><ambient>0.42 0.40 0.36 1</ambient><diffuse>0.42 0.40 0.36 1</diffuse></material></visual></link></model>
    <model name="end_e"><static>true</static><link name="l">
      <collision name="c"><pose>10.5 1.0 1.1 0 0 0</pose><geometry><box><size>0.15 6.0 2.2</size></box></geometry></collision>
      <visual name="v"><pose>10.5 1.0 1.1 0 0 0</pose><geometry><box><size>0.15 6.0 2.2</size></box></geometry>
        <material><ambient>0.76 0.78 0.82 1</ambient><diffuse>0.76 0.78 0.82 1</diffuse></material></visual></link></model>
  </world>
</sdf>
