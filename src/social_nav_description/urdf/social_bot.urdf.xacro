<?xml version="1.0"?>
<!-- Differential-drive robot for the SocialNav Planner (MASTER_PROMPT §27).
     ~0.6 m wide (see §22 narrow-corridor tests), 2 drive wheels + caster, 360-deg lidar.
     Gazebo Classic 11 plugins: diff drive (cmd_vel/odom) + ray sensor (/scan). -->
<robot name="social_bot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="base_len" value="0.45"/>
  <xacro:property name="base_wid" value="0.45"/>
  <xacro:property name="base_hgt" value="0.18"/>
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_sep" value="0.50"/>
  <xacro:property name="base_z" value="0.12"/>

  <material name="grey"><color rgba="0.4 0.4 0.45 1.0"/></material>
  <material name="dark"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>

  <!-- Inertial helper for a solid box. -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
        izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cyl_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r+h*h)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(3*r*r+h*h)/12.0}" iyz="0.0"
        izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- base_footprint is the ground-projected control frame used by Nav2/diff drive. -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_len} ${base_wid} ${base_hgt}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="${base_len} ${base_wid} ${base_hgt}"/></geometry>
    </collision>
    <xacro:box_inertia m="6.0" x="${base_len}" y="${base_wid}" z="${base_hgt}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <!-- Drive wheels -->
  <xacro:macro name="wheel" params="name y_side">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cyl_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="0 ${y_side} ${-base_z + wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${name}">
      <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="left_wheel" y_side="${wheel_sep/2.0}"/>
  <xacro:wheel name="right_wheel" y_side="${-wheel_sep/2.0}"/>

  <!-- Passive low-friction caster spheres, front AND rear, so the wheels-at-centre base
       stays level (a single caster leaves one end unsupported and it tips/drags). -->
  <xacro:macro name="caster" params="name x_off">
    <link name="${name}">
      <visual>
        <geometry><sphere radius="${wheel_radius/2.0}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry><sphere radius="${wheel_radius/2.0}"/></geometry>
      </collision>
      <xacro:cyl_inertia m="0.2" r="${wheel_radius/2.0}" h="${wheel_radius}"/>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x_off} 0 ${-base_z + wheel_radius/2.0}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${name}">
      <mu1>0.0</mu1><mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="caster_front" x_off="${base_len/2.0 - 0.06}"/>
  <xacro:caster name="caster_rear" x_off="${-(base_len/2.0 - 0.06)}"/>

  <!-- 360-degree lidar -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <xacro:cyl_inertia m="0.1" r="0.04" h="0.05"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${base_hgt/2.0 + 0.03}" rpy="0 0 0"/>
  </joint>

  <!-- ================= Gazebo Classic plugins ================= -->
  <gazebo reference="base_link"><material>Gazebo/Grey</material></gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_diameter>${2.0*wheel_radius}</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range><min>0.12</min><max>10.0</max><resolution>0.01</resolution></range>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
